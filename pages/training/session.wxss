.page {
  min-height: 100vh;
  background: #2c2c2e;
  display: flex;
  flex-direction: column;
  color: #fff;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  background: #1c1c1e;
}
.timer-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.timer-text {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.timer-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid #4cd964;
  color: #4cd964;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 4rpx;
  box-sizing: border-box;
}
.timer-btn.paused {
  border-color: #8e8e93;
  color: #8e8e93;
}
.top-actions { display: flex; align-items: center; gap: 16rpx; }
.back-btn {
  background: #4cd964;
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 700;
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
}

/* 标题与统计 */
.title-row {
  background: #1c1c1e;
  padding: 0 32rpx 24rpx;
}
.title-edit {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.title-icon {
  font-size: 30rpx;
  color: #8e8e93;
}
.title-input {
  flex: 1;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
.title-placeholder { color: #636366; }
.title-stats {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

/* 滚动区 */
.session-body {
  flex: 1;
  padding: 24rpx 24rpx 0;
}
.bottom-space { height: 40rpx; }

/* 动作卡片 */
.ex-block {
  background: #3a3a3c;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.ex-block-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}
.ex-info { display: flex; align-items: center; gap: 20rpx; }
.ex-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #48484a;
  border: 4rpx solid #4cd964;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #fff;
  font-weight: 700;
}
.ex-title { display: flex; flex-direction: column; }
.ex-block-name { font-size: 34rpx; font-weight: 700; color: #fff; }
.ex-block-volume {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 6rpx;
}
.ex-gear { font-size: 34rpx; color: #4cd964; }

.ex-notes {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
}

.timer-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.switch-label { font-size: 26rpx; color: #aeaeb2; }
.switch-ctrl { transform: scale(0.78); }

/* 组行 */
.set-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  gap: 12rpx;
}
.set-idx {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #1c1c1e;
  color: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.set-input-wrap {
  position: relative;
  width: 120rpx;
  flex-shrink: 0;
}
.set-input {
  width: 100%;
  height: 76rpx;
  background: #4cd964;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1c1c1e;
  font-weight: 700;
  box-sizing: border-box;
  padding: 0 30rpx 0 0;
}
.input-unit {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #1c1c1e;
  font-weight: 600;
  opacity: 0.7;
}
.input-unit-left { left: 14rpx; }
.input-unit-right { right: 14rpx; }

.set-done {
  width: 88rpx;
  height: 76rpx;
  background: #4cd964;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1c1c1e;
  font-size: 38rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.set-done text { font-size: 24rpx; }
.set-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: auto;
  min-width: 64rpx;
}
.set-time {
  font-size: 24rpx;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.set-more {
  font-size: 32rpx;
  color: #4cd964;
  margin-top: 4rpx;
  line-height: 1;
}

.add-set {
  text-align: center;
  color: #4cd964;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 0;
  border: 1rpx dashed #4cd964;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

/* 难度评估 */
.difficulty-wrap {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 40rpx 40rpx;
}
.diff-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.diff-ring {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid #8e8e93;
}
.diff-label { font-size: 26rpx; color: #8e8e93; }

.diff-item[data-v="easy"].on .diff-ring { border-color: #4cd964; background: #4cd964; }
.diff-item[data-v="easy"].on .diff-label { color: #4cd964; }
.diff-item[data-v="normal"].on .diff-ring { border-color: #f5a623; background: #f5a623; }
.diff-item[data-v="normal"].on .diff-label { color: #f5a623; }
.diff-item[data-v="hard"].on .diff-ring { border-color: #ff3b30; background: #ff3b30; }
.diff-item[data-v="hard"].on .diff-label { color: #ff3b30; }

/* 心得输入 */
.notes-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 80;
  display: flex;
  align-items: flex-end;
}
.notes-sheet {
  width: 100%;
  background: #3a3a3c;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.notes-title { font-size: 30rpx; font-weight: 700; color: #fff; margin-bottom: 20rpx; }
.notes-area {
  width: 100%;
  height: 240rpx;
  background: #2c2c2e;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
}
.notes-btn {
  margin-top: 24rpx;
  background: #4cd964;
  color: #1c1c1e;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
}

/* 组间休息：右下角悬浮环形计时（不挡操作） */
.rest-float {
  position: fixed;
  right: 24rpx;
  bottom: calc(214rpx + env(safe-area-inset-bottom));
  width: 132rpx;
  height: 132rpx;
  background: rgba(28, 28, 30, 0.92);
  border: 1rpx solid #3a3a3c;
  border-radius: 50%;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.55);
  z-index: 50;
}
.rest-ring-canvas { width: 132rpx; height: 132rpx; display: block; }
.rest-float-center {
  position: absolute;
  left: 0; top: 0;
  width: 132rpx; height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.rest-float-sec {
  font-size: 46rpx;
  font-weight: 800;
  color: #4cd964;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.rest-float-unit { font-size: 20rpx; color: #aeaeb2; margin-top: 4rpx; }
.rest-float-skip {
  position: absolute;
  left: 0; right: 0;
  bottom: -34rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
}
.rest-float-label {
  position: absolute;
  left: -24rpx; right: -24rpx;
  top: -30rpx;
  text-align: center;
  font-size: 20rpx;
  color: #aeaeb2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部 tab */
.bottom-tab {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #1c1c1e;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  z-index: 40;
  border-top: 1rpx solid #3a3a3c;
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}
.tab-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #8e8e93;
}
.tab-add {
  background: #4cd964;
  color: #1c1c1e;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 700;
}
.tab-label { font-size: 22rpx; color: #8e8e93; }

/* 悬浮结束按钮 */
.finish-float {
  position: fixed;
  right: 28rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: #4cd964;
  color: #1c1c1e;
  font-size: 26rpx;
  font-weight: 700;
  padding: 18rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(76,217,100,0.35);
  z-index: 45;
}

/* 完成页 */
.finished {
  flex: 1;
  padding: 80rpx 48rpx;
  text-align: center;
}
.finish-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
}
.finish-row {
  font-size: 30rpx;
  color: #aeaeb2;
  margin-top: 28rpx;
}
.finish-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #4cd964;
  margin: 0 8rpx;
}
.finish-pr {
  margin-top: 48rpx;
  background: #3a3a3c;
  border-radius: 20rpx;
  padding: 32rpx;
}
.finish-pr-title { font-size: 26rpx; color: #8e8e93; margin-bottom: 16rpx; }
.finish-pr-item { font-size: 28rpx; color: #fff; padding: 10rpx 0; }
.finish-btn {
  margin-top: 60rpx;
  background: #4cd964;
  color: #1c1c1e;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
}

/* 动作选择弹窗 */
.sheet-mask {
  position: fixed; left: 0; right: 0; bottom: 0; top: 0;
  background: rgba(0,0,0,0.55);
  z-index: 70;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #3a3a3c;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx 16rpx;
}
.sheet-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.sheet-close { font-size: 36rpx; color: #8e8e93; }
.sheet-body { padding: 0 32rpx; flex: 1; }
.search { padding: 8rpx 32rpx 12rpx; }
.search-input {
  background: #2c2c2e;
  border-radius: 30rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
}
.pick-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 4rpx; border-bottom: 1rpx solid #48484a;
}
.pick-name { font-size: 28rpx; color: #fff; font-weight: 500; }
.pick-group { font-size: 22rpx; color: #8e8e93; }
