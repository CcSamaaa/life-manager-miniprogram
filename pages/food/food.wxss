.page { padding: 0 28rpx 60rpx; background: #f5f6f8; min-height: 100vh; }

.hero { padding: 36rpx 4rpx 20rpx; }
.hero-title { font-size: 46rpx; font-weight: 700; color: #1a1a1a; }
.hero-sub { font-size: 26rpx; color: #8a8a8e; margin-top: 8rpx; }

/* 拍照区 */
.capture {
  margin-top: 16rpx;
  height: 360rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eafaf0, #f4fbf6);
  border: 2rpx dashed #b7e3c8;
  overflow: hidden;
}
.capture-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cap-ico { font-size: 80rpx; }
.cap-text { font-size: 30rpx; color: #2f8a55; font-weight: 600; margin-top: 14rpx; }
.cap-hint { font-size: 23rpx; color: #9bb3a6; margin-top: 8rpx; }
.capture-img { width: 100%; height: 100%; }

/* 识别中 */
.loading {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}
.spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid #d7e9df;
  border-top-color: #07c160;
  border-radius: 50%;
  margin-right: 18rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 27rpx; color: #6b7d73; }

/* 结果卡片 */
.result-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}
.mock-tip {
  font-size: 22rpx;
  color: #b06a00;
  background: #fff6e6;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 18rpx;
  line-height: 1.5;
}
.res-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 14rpx; }
.food-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.food-name { font-size: 28rpx; color: #2a2a2a; }
.food-meta { font-size: 25rpx; color: #8a8a8e; }
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 18rpx;
}
.total-label { font-size: 28rpx; color: #1a1a1a; font-weight: 600; }
.total-num { font-size: 40rpx; font-weight: 700; color: #07a050; }

.res-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-ghost, .btn-primary {
  flex: 1;
  font-size: 29rpx;
  border-radius: 16rpx;
  padding: 18rpx 0;
  margin: 0;
  line-height: 1.4;
}
.btn-ghost { background: #f2f3f5; color: #555; }
.btn-primary { background: #07c160; color: #fff; }
.btn-primary[loading] { opacity: 0.7; }

/* 历史 */
.section-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin: 40rpx 4rpx 16rpx; }
.empty { text-align: center; color: #9a9a9e; font-size: 26rpx; padding: 50rpx 0; }

.log-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}
.log-img { width: 96rpx; height: 96rpx; border-radius: 14rpx; flex-shrink: 0; background: #f0f1f3; }
.log-body { flex: 1; margin-left: 20rpx; overflow: hidden; }
.log-date { font-size: 24rpx; color: #9a9a9e; }
.log-foods {
  font-size: 27rpx; color: #2a2a2a;
  margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.log-total { font-size: 32rpx; font-weight: 700; color: #07a050; flex-shrink: 0; }
.log-unit { font-size: 20rpx; font-weight: 400; color: #9a9a9e; margin-left: 2rpx; }
.log-del {
  width: 48rpx; height: 48rpx;
  margin-left: 12rpx;
  display: flex; align-items: center; justify-content: center;
  color: #c0c0c4; font-size: 30rpx; flex-shrink: 0;
}

/* ===== 深色模式 ===== */
.page.dark { background: #15171a; }
.page.dark .hero-title { color: #f0f2f5; }
.page.dark .hero-sub { color: #8b9098; }
.page.dark .capture { background: linear-gradient(135deg, #1c2a22, #20281f); border-color: #2f5a42; }
.page.dark .cap-text { color: #34d27e; }
.page.dark .cap-hint { color: #7b9387; }
.page.dark .loading-text { color: #8b9098; }
.page.dark .result-card { background: #23262b; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.35); }
.page.dark .mock-tip { color: #e0a44a; background: #2a2418; }
.page.dark .res-title { color: #f0f2f5; }
.page.dark .food-row { border-bottom: 1rpx solid #2b2f36; }
.page.dark .food-name { color: #d6d9de; }
.page.dark .food-meta { color: #8b9098; }
.page.dark .total-label { color: #f0f2f5; }
.page.dark .total-num { color: #34d27e; }
.page.dark .btn-ghost { background: #2b2f36; color: #c8ccd2; }
.page.dark .section-title { color: #f0f2f5; }
.page.dark .empty { color: #8b9098; }
.page.dark .log-card { background: #23262b; }
.page.dark .log-img { background: #2b2f36; }
.page.dark .log-date { color: #8b9098; }
.page.dark .log-foods { color: #d6d9de; }
.page.dark .log-total { color: #34d27e; }
.page.dark .log-unit { color: #8b9098; }
.page.dark .log-del { color: #6b7077; }
