.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 日历卡片 */
.cal-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  padding: 24rpx 20rpx 16rpx;
  margin-bottom: 24rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 16rpx;
}
.cal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}
.nav-btn {
  font-size: 44rpx;
  color: #07c160;
  width: 72rpx;
  text-align: center;
  font-weight: 700;
}
.cal-week {
  display: flex;
  border-bottom: 1rpx solid #f2f3f5;
  padding-bottom: 12rpx;
}
.wk {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9aa0a6;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 8rpx;
}
.cell {
  width: 14.2857%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 16rpx;
  position: relative;
}
.cell.out { opacity: 0.32; }
.day {
  font-size: 28rpx;
  color: #333;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
}
.cell.today .day {
  background: #e8f7ee;
  color: #07c160;
  font-weight: 700;
}
.cell.sel .day {
  background: #07c160;
  color: #fff;
  font-weight: 700;
}
/* 心情色点 */
.mood-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
}
.cell.sel .mood-dot { box-shadow: 0 0 0 2rpx rgba(255,255,255,0.8); }
.cal-foot {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}
.back-today {
  font-size: 24rpx;
  color: #07c160;
  padding: 8rpx 28rpx;
  border: 1rpx solid #07c160;
  border-radius: 30rpx;
}

/* 编辑面板 */
.panel {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  padding: 24rpx 24rpx 28rpx;
}
.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.ph-date {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}
.ph-tip {
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 心情选择 */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.mood-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  background: #f5f6f8;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
}
.mood-chip.active {
  border-color: #07c160;
  background: #e8f7ee;
}
.mood-chip .mood-dot { margin-top: 0; margin-right: 12rpx; }
.mood-label {
  font-size: 26rpx;
  color: #333;
}
.mood-chip.add { color: #07c160; }
.mood-plus {
  font-size: 32rpx;
  margin-right: 6rpx;
  font-weight: 700;
  line-height: 1;
}

/* 备注 */
.note-input {
  width: 100%;
  min-height: 150rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  color: #1f1f1f;
  margin-top: 22rpx;
  box-sizing: border-box;
}
.note-ph { color: #b0b3b8; }

/* 操作行 */
.row-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18rpx;
}
.save-btn {
  font-size: 27rpx;
  color: #fff;
  background: #07c160;
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
  font-weight: 600;
}
.del-btn {
  font-size: 26rpx;
  color: #e64340;
  margin-left: 28rpx;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  color: #b0b3b8;
  margin-top: 28rpx;
  line-height: 1.6;
}

/* 自定义弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 580rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 36rpx 28rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-input {
  height: 80rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #1f1f1f;
}
.modal-ph { color: #b0b3b8; }
.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 28rpx 0 8rpx;
  justify-content: center;
}
.color-swatch {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}
.color-swatch.on {
  border-color: #1f1f1f;
  transform: scale(1.08);
}
.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}
.m-cancel {
  font-size: 30rpx;
  color: #9aa0a6;
  padding: 12rpx 40rpx;
}
.m-ok {
  font-size: 30rpx;
  color: #fff;
  background: #07c160;
  padding: 12rpx 44rpx;
  border-radius: 30rpx;
  font-weight: 600;
}

/* ===== 深色模式 ===== */
.page.dark .cal-card,
.page.dark .panel {
  background: #23262b;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.35);
}
.page.dark .cal-title { color: #f0f2f5; }
.page.dark .cal-week { border-bottom: 1rpx solid #2b2f36; }
.page.dark .wk { color: #8b9098; }
.page.dark .day { color: #d6d9de; }
.page.dark .cell.out { opacity: 0.4; }
.page.dark .cell.today .day { background: #1f3a2a; color: #34d27e; }
.page.dark .cell.sel .day { background: #07c160; color: #fff; }
.page.dark .panel-head { border-bottom: 1rpx solid #2b2f36; }
.page.dark .ph-date { color: #f0f2f5; }
.page.dark .ph-tip { color: #8b9098; }
.page.dark .mood-chip { background: #2b2f36; }
.page.dark .mood-chip.active { background: #1f3a2a; border-color: #34d27e; }
.page.dark .mood-label { color: #d6d9de; }
.page.dark .mood-chip.add { color: #34d27e; }
.page.dark .note-input { background: #2b2f36; color: #f0f2f5; }
.page.dark .note-ph { color: #7b8087; }
.page.dark .hint { color: #6b7077; }
.page.dark .modal { background: #23262b; }
.page.dark .modal-title { color: #f0f2f5; }
.page.dark .modal-input { background: #2b2f36; color: #f0f2f5; }
.page.dark .modal-ph { color: #7b8087; }
.page.dark .color-swatch.on { border-color: #f0f2f5; }
