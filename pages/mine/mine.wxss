.page {
  min-height: 100vh;
  padding: 20rpx 0 60rpx;
  background: #f5f6f8;
}

/* 资料卡 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 48rpx 36rpx;
  background: linear-gradient(135deg, #07c160, #34d27e);
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,.6);
}
.avatar-img { width: 100%; height: 100%; }
.avatar-ph { font-size: 64rpx; }
.pinfo { margin-left: 28rpx; flex: 1; }
.pname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}
.phint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,.85);
}

/* 表单 */
.form {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.row:last-child { border-bottom: none; }
.label { font-size: 29rpx; color: #333; }
.value { font-size: 29rpx; color: #1f1f1f; }
.value-input {
  text-align: right;
  font-size: 29rpx;
  color: #1f1f1f;
}
.arrow { color: #c0c4cc; margin-left: 8rpx; }

/* 活动系数说明 */
.act-hint {
  margin: 20rpx 24rpx 0;
  font-size: 22rpx;
  color: #9aa0a6;
  line-height: 1.6;
}

/* 代谢卡 */
.bmr-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx 28rpx 24rpx;
}
.bmr-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.bk { font-size: 27rpx; color: #666; }
.bv { font-size: 30rpx; font-weight: 700; color: #07c160; }
.bmr-tip {
  font-size: 22rpx;
  color: #b0b3b8;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 保存 */
.save-btn {
  margin: 40rpx 24rpx 0;
  background: #07c160;
  color: #fff;
  font-size: 31rpx;
  border-radius: 44rpx;
}
.save-btn::after { border: none; }

/* 外观设置开关 */
.switch-row { padding: 24rpx 28rpx; }
.theme-switch { transform: scale(0.92); }

/* ===== 深色模式 ===== */
.page.dark { background: #15171a; }
.page.dark .form { background: #23262b; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3); }
.page.dark .row { border-bottom: 1rpx solid #2b2f36; }
.page.dark .label { color: #c8ccd2; }
.page.dark .value { color: #f0f2f5; }
.page.dark .value-input { color: #f0f2f5; }
.page.dark .arrow { color: #6b7077; }
.page.dark .act-hint { color: #8b9098; }
.page.dark .bmr-card { background: #23262b; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3); }
.page.dark .bmr-item { border-bottom: 1rpx solid #2b2f36; }
.page.dark .bk { color: #8b9098; }
.page.dark .bv { color: #34d27e; }
.page.dark .bmr-tip { color: #6b7077; }
