.page {
  min-height: 100vh;
  padding: 16rpx 0 40rpx;
}

.empty {
  margin-top: 80rpx;
}

.habit-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.emoji {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
}

.sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.del {
  font-size: 24rpx;
  color: #fa5151;
  padding: 8rpx 16rpx;
}

.add-btn {
  margin: 32rpx 24rpx 0;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
}

/* 表单弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #9aa0a6;
  margin-bottom: 12rpx;
}

.input {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.emoji-grid {
  max-height: 200rpx;
  display: flex;
  flex-wrap: wrap;
}

.emoji-cell {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 12rpx;
}

.emoji-cell.active {
  background: #e8f8ee;
  border: 2rpx solid #07c160;
}

.seg {
  display: flex;
  background: #f5f6f8;
  border-radius: 12rpx;
  overflow: hidden;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #1f1f1f;
}

.seg-item.on {
  background: #07c160;
  color: #fff;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f6f8;
  border-radius: 12rpx;
  font-size: 40rpx;
  color: #1f1f1f;
}

.step-val {
  width: 120rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.save-btn {
  margin-top: 16rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
}

/* ===== 深色模式 ===== */
.page.dark { background: #15171a; }
.page.dark .habit-row { background: #23262b; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3); }
.page.dark .name { color: #f0f2f5; }
.page.dark .sub { color: #8b9098; }
.page.dark .sheet { background: #23262b; }
.page.dark .sheet-title { color: #f0f2f5; }
.page.dark .label { color: #8b9098; }
.page.dark .input { background: #2b2f36; color: #f0f2f5; }
.page.dark .emoji-cell.active { background: #1f3a2a; border-color: #07c160; }
.page.dark .seg { background: #2b2f36; }
.page.dark .seg-item { color: #d6d9de; }
.page.dark .step-btn { background: #2b2f36; color: #d6d9de; }
.page.dark .step-val { color: #f0f2f5; }
