.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 日历卡片 */
.cal-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  padding: 24rpx 20rpx 16rpx;
  margin-bottom: 24rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 16rpx;
}
.cal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}
.nav-btn {
  font-size: 44rpx;
  color: #07c160;
  width: 72rpx;
  text-align: center;
  font-weight: 700;
}
.cal-week {
  display: flex;
  border-bottom: 1rpx solid #f2f3f5;
  padding-bottom: 12rpx;
}
.wk {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9aa0a6;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 8rpx;
}
.cell {
  width: 14.2857%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 12rpx;
  position: relative;
}
.cell.out { opacity: 0.32; }
.day {
  font-size: 28rpx;
  color: #333;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
}
.cell.today .day {
  background: #e8f7ee;
  color: #07c160;
  font-weight: 700;
}
.cell.sel .day {
  background: #07c160;
  color: #fff;
  font-weight: 700;
}
/* 日历格内的小标签 */
.tags {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 4rpx;
  width: 100%;
}
.tag {
  max-width: 96%;
  font-size: 17rpx;
  line-height: 1.5;
  color: #6b7077;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 0 6rpx;
  margin-top: 3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tag.more {
  color: #07c160;
  background: #e8f7ee;
}
.cal-foot {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}
.back-today {
  font-size: 24rpx;
  color: #07c160;
  padding: 8rpx 28rpx;
  border: 1rpx solid #07c160;
  border-radius: 30rpx;
}

/* 规划面板 */
.panel {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  padding: 24rpx 24rpx 28rpx;
}
.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.ph-date {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}
.ph-tip {
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 这天已安排 */
.day-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
  min-height: 44rpx;
}
.day-chip {
  display: flex;
  align-items: center;
  padding: 10rpx 14rpx 10rpx 20rpx;
  background: #e8f7ee;
  border: 2rpx solid #07c160;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #057a45;
}
.day-chip .x {
  margin-left: 8rpx;
  font-size: 30rpx;
  color: #057a45;
  font-weight: 700;
}

/* 分区标题 */
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin: 26rpx 0 14rpx;
}
.st-text { display: flex; align-items: baseline; }
.sec-tip {
  font-size: 20rpx;
  font-weight: 400;
  color: #b0b3b8;
  margin-left: 10rpx;
}
.add-toggle {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 600;
}

/* 添加自定义输入行 */
.add-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.add-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: #1f1f1f;
}
.add-ph { color: #b0b3b8; }
.add-btn {
  font-size: 27rpx;
  color: #fff;
  background: #07c160;
  padding: 14rpx 34rpx;
  border-radius: 30rpx;
  font-weight: 600;
}

/* 食物选择网格 */
.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.food-chip {
  padding: 12rpx 24rpx;
  background: #f5f6f8;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #333;
}
.food-chip.active {
  border-color: #07c160;
  background: #e8f7ee;
  color: #057a45;
  font-weight: 600;
}
.food-chip.custom {
  border: 2rpx dashed #cfd3d8;
}
.food-chip.custom.active {
  border-style: solid;
}
.empty {
  font-size: 24rpx;
  color: #b0b3b8;
}
.empty.small {
  font-size: 23rpx;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  color: #b0b3b8;
  margin-top: 28rpx;
  line-height: 1.6;
}

/* ===== 深色模式 ===== */
.page.dark .cal-card,
.page.dark .panel {
  background: #23262b;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.35);
}
.page.dark .cal-title { color: #f0f2f5; }
.page.dark .cal-week { border-bottom: 1rpx solid #2b2f36; }
.page.dark .wk { color: #8b9098; }
.page.dark .day { color: #d6d9de; }
.page.dark .cell.out { opacity: 0.4; }
.page.dark .cell.today .day { background: #1f3a2a; color: #34d27e; }
.page.dark .cell.sel .day { background: #07c160; color: #fff; }
.page.dark .tag { background: #2b2f36; color: #b8bdc4; }
.page.dark .tag.more { background: #1f3a2a; color: #34d27e; }
.page.dark .panel-head { border-bottom: 1rpx solid #2b2f36; }
.page.dark .ph-date { color: #f0f2f5; }
.page.dark .ph-tip { color: #8b9098; }
.page.dark .day-chip { background: #1f3a2a; border-color: #34d27e; color: #8fe3b0; }
.page.dark .day-chip .x { color: #8fe3b0; }
.page.dark .sec-title { color: #f0f2f5; }
.page.dark .sec-tip { color: #6b7077; }
.page.dark .add-input { background: #2b2f36; color: #f0f2f5; }
.page.dark .add-ph { color: #7b8087; }
.page.dark .food-chip { background: #2b2f36; color: #d6d9de; }
.page.dark .food-chip.active { background: #1f3a2a; border-color: #34d27e; color: #8fe3b0; }
.page.dark .food-chip.custom { border-color: #3a3f47; }
.page.dark .empty { color: #6b7077; }
.page.dark .hint { color: #6b7077; }
