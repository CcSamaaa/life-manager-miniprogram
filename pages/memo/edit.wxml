<view class="editor {{theme}}">
  <view class="topbar" style="padding-top:{{statusBar}}px">
    <view class="tb-back" bindtap="back">‹ 灵感记录</view>
    <view class="tb-actions">
      <view wx:if="{{canDelete}}" class="tb-trash" bindtap="onDelete">🗑</view>
    </view>
  </view>

  <scroll-view scroll-y class="body-scroll">
    <view class="date-head">{{dateText}}</view>
    <textarea
      class="editor-area"
      value="{{content}}"
      bindinput="onInput"
      placeholder="开始输入..."
      placeholder-class="ph"
      auto-focus
      show-confirm-bar="{{false}}"
      adjust-position="{{true}}"
    />
  </scroll-view>
</view>
