.editor {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

/* 自定义导航栏（仿 iOS 大返回 + 废纸篓） */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 18rpx;
  padding-right: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.tb-back {
  font-size: 34rpx;
  font-weight: 500;
  color: #fa9d3b;
  padding: 12rpx 10rpx;
}
.tb-actions { display: flex; align-items: center; }
.tb-trash {
  font-size: 38rpx;
  padding: 10rpx 14rpx;
}

.body-scroll { flex: 1; }
.date-head {
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b4;
  padding: 18rpx 0 8rpx;
}
.editor-area {
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx 30rpx 60rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #111;
  min-height: 60vh;
}
.ph { color: #c0c0c4; }

/* ===== 深色模式 ===== */
.editor.dark { background: #15171a; }
.editor.dark .topbar { border-bottom: 1rpx solid #2b2f36; }
.editor.dark .date-head { color: #6b7077; }
.editor.dark .editor-area { color: #f0f2f5; }
.editor.dark .ph { color: #7b8087; }
