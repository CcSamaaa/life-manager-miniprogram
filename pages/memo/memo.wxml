<view class="page {{theme}}">
  <view class="head">
    <text class="big-title">灵感记录</text>
    <view class="compose" bindtap="newNote">✎</view>
  </view>

  <view class="search">
    <view class="search-box">
      <text class="search-ico">🔍</text>
      <input class="search-input" value="{{kw}}" bindinput="onSearch" placeholder="搜索" placeholder-class="ph" confirm-type="search" />
    </view>
  </view>

  <view class="section-label" wx:if="{{filtered.length > 0}}">全部灵感记录</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{filtered.length === 0}}" class="empty">还没有灵感记录\n点击右上角 ✎ 新建一条</view>

  <view class="list" wx:else>
    <view class="row-wrap" wx:for="{{filtered}}" wx:key="_id">
      <view
        class="row {{swipeId === item._id ? 'open' : ''}}"
        data-id="{{item._id}}"
        bindtouchstart="touchStart"
        bindtouchend="touchEnd"
        bindtap="openNote"
      >
        <view class="row-title">{{item.title}}</view>
        <view class="row-preview" wx:if="{{item.preview}}">{{item.preview}}</view>
        <view class="row-date">{{item.dateText}}</view>
      </view>
      <view class="del-btn" data-id="{{item._id}}" catchtap="delNote">删除</view>
    </view>
  </view>
</view>
